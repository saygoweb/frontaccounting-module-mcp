<?xml version="1.0"?>
<ruleset name="FrontAccounting MCP">
    <description>Coding standard for the FrontAccounting MCP module.</description>

    <rule ref="PSR12"/>

    <file>src</file>
    <file>tests</file>
    <file>hooks.php</file>
    <file>index.php</file>
    <file>app.php</file>
    <file>container.php</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <!-- FrontAccounting's own names, declared for phpstan only. -->
    <exclude-pattern>tests/phpstan/*</exclude-pattern>

    <!-- hooks.php is FrontAccounting-style by contract: a global, snake_case
         hooks_<module> class with snake_case methods FrontAccounting calls. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>hooks.php</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName.NotCamelCaps">
        <exclude-pattern>hooks.php</exclude-pattern>
    </rule>
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>hooks.php</exclude-pattern>
    </rule>

    <arg value="p"/>
    <arg name="colors"/>
    <arg value="s"/>
</ruleset>
